#!/bin/sh
# Remove only the browser registration; leave Chrome profile data untouched.
set -eu

base=/usr/share/yousub
[ -f "$base/yousub-id.txt" ] || exit 0
extension=$(cat "$base/yousub-id.txt")

for directory in /usr/share/google-chrome/extensions /opt/google/chrome/extensions \
  /usr/share/chromium/extensions /etc/chromium/extensions; do
  [ -z "$extension" ] || rm -f "$directory/$extension.json"
done

exit 0
