#!/bin/sh
# Register the signed CRX for Chrome/Chromium. No CLI or helper program.
set -eu

[ "${1:-}" = configure ] || exit 0

base=/usr/share/yousub
[ -f "$base/extension-id" ] || exit 0
extension=$(cat "$base/extension-id")
[ -n "$extension" ] || exit 0

for directory in /usr/share/google-chrome/extensions /opt/google/chrome/extensions \
  /usr/share/chromium/extensions /etc/chromium/extensions; do
  install -d -m 0755 "$directory"
  install -m 0644 "$base/yousub-external.json" "$directory/$extension.json"
done

exit 0
