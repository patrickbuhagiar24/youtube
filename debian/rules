#!/usr/bin/make -f
# Rootless, static-file packaging. No compiler or npm registry access is needed.
include /usr/share/dpkg/default.mk

PACKAGE := yt-unsub-detector
DEST := debian/$(PACKAGE)
SHARE := $(DEST)/usr/share/$(PACKAGE)
DOC := $(DEST)/usr/share/doc/$(PACKAGE)
EXT := $(SHARE)/extension

.PHONY: build build-arch build-indep binary binary-arch binary-indep clean test
build: test
build-arch:
build-indep: build
binary-arch:
binary: binary-indep binary-arch

test:
	node --check background.js
	node --check shared.js
	node --check drive.js
	node --check content/content.js
	node --check content/main-world.js
	node --check popup/popup.js
	node --test tests/*.test.cjs
	python3 -m unittest discover -s tests -p 'test_*.py' -v

binary-indep: test
	rm -rf "$(DEST)"
	install -d "$(EXT)/content" "$(EXT)/popup" "$(EXT)/icons" "$(DOC)" "$(DEST)/usr/bin" "$(DEST)/usr/share/man/man1" "$(DEST)/DEBIAN"
	install -m 0644 manifest.json background.js shared.js drive.js YouTube.json "$(EXT)/"
	install -m 0644 content/content.js content/content.css content/main-world.js "$(EXT)/content/"
	install -m 0644 popup/popup.html popup/popup.css popup/popup.js "$(EXT)/popup/"
	install -m 0644 icons/*.png "$(EXT)/icons/"
	install -m 0644 packaging/cli.py packaging/config_store.py packaging/browser_setup.py "$(SHARE)/"
	install -m 0755 packaging/yt-unsub-detector-native-host "$(DEST)/usr/bin/yt-unsub-detector-native-host"
	install -m 0755 packaging/yt-unsub-detector "$(DEST)/usr/bin/yt-unsub-detector"
	install -m 0644 debian/copyright "$(DOC)/copyright"
	gzip -n -9 -c debian/changelog > "$(DOC)/changelog.gz"
	gzip -n -9 -c README.md > "$(DOC)/README.md.gz"
	gzip -n -9 -c debian/yt-unsub-detector.1 > "$(DEST)/usr/share/man/man1/yt-unsub-detector.1.gz"
	find "$(DEST)/usr" -type f -print0 | sort -z | xargs -0 md5sum | sed 's|$(DEST)/||' > "$(DEST)/DEBIAN/md5sums"
	install -m 0755 debian/postinst debian/postrm "$(DEST)/DEBIAN/"
	dpkg-gencontrol -p$(PACKAGE) -P$(DEST)
	chmod 0755 "$(DEST)/DEBIAN"
	dpkg-deb --root-owner-group --build "$(DEST)" "../$(PACKAGE)_$(DEB_VERSION)_all.deb"

clean:
	rm -rf "$(DEST)" debian/files debian/*.substvars debian/debhelper-build-stamp
