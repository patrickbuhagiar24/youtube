# Local credentials and extension signing keys must never be committed.
/service-account.json
/yousub.pem
*.private.asc
*.pem
*.key
.env
.env.*

# Test tooling output. package.json and package-lock.json are intentionally kept:
# the side-panel tests need jsdom and CI installs it with "npm ci".
/.cache/
/dist/
/artifacts/
/node_modules/
/.venv/
__pycache__/
*.pyc
