{
  "name": "yousub-tests",
  "private": true,
  "description": "Test tooling for the Yousub Chrome extension. The extension has no build step and no runtime dependencies; jsdom, ESLint and TypeScript are development dependencies only.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=*.js --test-coverage-include=content/*.js --test-coverage-include=popup/*.js --test-coverage-lines=63 --test-coverage-branches=59 --test-coverage-functions=50 tests/*.test.cjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.8",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3"
  }
}
